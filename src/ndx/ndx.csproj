<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PublishAot>true</PublishAot>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StackTraceSupport>true</StackTraceSupport>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AssemblyName>ndx</AssemblyName>
    <PackageId>ndx</PackageId>
    <_NdxWindows>false</_NdxWindows>
    <_NdxWindows Condition="$([MSBuild]::IsOSPlatform('Windows'))">true</_NdxWindows>
    <_NdxWindows Condition="$(RuntimeIdentifier.StartsWith('win'))">true</_NdxWindows>
    <_NdxWindows Condition="$(RuntimeIdentifier) != '' and !$(RuntimeIdentifier.StartsWith('win'))">false</_NdxWindows>
    <DefineConstants Condition="'$(_NdxWindows)' == 'true'">$(DefineConstants);NDX_WINDOWS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="PortableRuntimeIdentifierGraph.json" LogicalName="PortableRuntimeIdentifierGraph.json" />
  </ItemGroup>
</Project>